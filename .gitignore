# Training output. Weights and charts stay out of git, except the live model's
# best.pt. Every run's small record (notes.txt, args.yaml, results.csv) is kept,
# so what was trained, on what, with what result, is always in the history.
*.pt
models/*
!models/cards/
!models/model_*/
models/cards/*
models/model_*/*
!models/cards/notes.txt
!models/cards/args.yaml
!models/cards/results.csv
!models/cards/LIVE.txt
!models/model_*/notes.txt
!models/model_*/args.yaml
!models/model_*/results.csv
!models/cards/weights/
models/cards/weights/*
!models/cards/weights/best.pt

# Zones edited for one camera setup
data/seats.json
data.zip
# The project zipped for Google Colab (docs/training.md)
BreakTheBank.zip

# Generated or downloaded data. The labelled exports come from the team's shared
# folder (see data/README.md); data/manifest.json records what they must contain.
data/dataset/
data/raw/labeled/
data/raw/unused/
data/raw/frames/
data/merged/
data/synthetic/
